#!/bin/sh /etc/rc.common
# ProxyBox core service: sing-box transparent proxy.
START=95
STOP=10
USE_PROCD=1

ROOT=/opt/proxybox

start_service() {
  [ -x "$ROOT/bin/sing-box" ] || { echo "sing-box missing at $ROOT/bin/sing-box" >&2; return 1; }
  [ -f "$ROOT/etc/config.json" ] || { echo "no config at $ROOT/etc/config.json (deploy from panel first)" >&2; return 1; }
  procd_open_instance
  procd_set_param command "$ROOT/bin/sing-box" run -c "$ROOT/etc/config.json"
  procd_set_param respawn 3600 5 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}

running() {
  pgrep -f "sing-box run -c $ROOT/etc/config.json" >/dev/null 2>&1
}
